# --- Base de données ------------------------------------------------------
# Supabase en production. La migration 20260916162000_init est déjà appliquée.
DATABASE_URL="postgresql://genk:genk@localhost:5432/genk?schema=public"

# --- Application ----------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-value"
# Base des liens de confirmation envoyés par WhatsApp. Doit être publiquement
# joignable : le lien est ouvert hors de l'application mobile.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Durée du blocage du créneau et de validité du lien de confirmation (minutes).
BOOKING_HOLD_MINUTES="60"
# Devise affichée côté client. Doit rester alignée avec FEDAPAY_CURRENCY.
NEXT_PUBLIC_CURRENCY="XOF"

# --- WhatsApp Cloud API (Meta) --------------------------------------------
# Identifiant du numéro émetteur (WhatsApp Manager > API Setup).
WHATSAPP_PHONE_NUMBER_ID=""
# Token d'un System User permanent. Jamais un token temporaire de 24 h.
WHATSAPP_ACCESS_TOKEN=""
# Template approuvé contenant un bouton URL dynamique vers /confirmation/{token}.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="fr"
WHATSAPP_API_VERSION="v25.0"
# Indicatif appliqué aux numéros saisis sans "+" (ex. "229" pour le Bénin).
WHATSAPP_DEFAULT_COUNTRY_CODE=""

# --- FedaPay (collecte XOF) -----------------------------------------------
# sandbox | live
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_API_VERSION="v1"
FEDAPAY_SECRET_KEY=""
# Secret du endpoint webhook (FedaPay Dashboard > Webhooks).
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_CURRENCY="XOF"
# Pays par défaut du numéro client transmis à FedaPay.
FEDAPAY_CUSTOMER_COUNTRY="bj"

# --- Android (Capacitor) ---------------------------------------------------
CAPACITOR_SERVER_URL="https://your-deployed-genk.example.com"
