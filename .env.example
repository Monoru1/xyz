# --- Base de données ------------------------------------------------------
# Supabase en production. La migration 20260916162000_init est déjà appliquée.
DATABASE_URL="postgresql://genk:genk@localhost:5432/genk?schema=public"

# --- Application ----------------------------------------------------------
# Secret de signature des JWT de session. `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-long-random-value"
# URL canonique utilisée par Auth.js pour les callbacks. La renseigner en
# production évite de faire confiance à l'en-tête Host derrière un proxy.
AUTH_URL="http://localhost:3000"
# Base des liens de confirmation envoyés par WhatsApp. Doit être publiquement
# joignable : le lien est ouvert hors de l'application mobile.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Durée du blocage du créneau et de validité du lien de confirmation (minutes).
BOOKING_HOLD_MINUTES="60"
# Devise affichée côté client. Doit rester alignée avec FEDAPAY_CURRENCY.
NEXT_PUBLIC_CURRENCY="XOF"
# Fuseau du serveur. Les créneaux sont calculés en heure locale du processus :
# le définir explicitement, sinon un hébergeur en UTC décale les horaires.
TZ="Africa/Porto-Novo"

# --- Anti-abus /api/bookings ----------------------------------------------
# Chaque réservation déclenche un message WhatsApp facturé. Ces plafonds, tenus
# en base PostgreSQL, bornent le nombre de demandes par contact et par fenêtre.
BOOKING_RATE_WINDOW_MINUTES="60"
BOOKING_RATE_MAX_PER_PHONE="3"
BOOKING_RATE_MAX_PER_EMAIL="5"

# --- WhatsApp Cloud API (Meta) --------------------------------------------
# Identifiant du numéro émetteur (WhatsApp Manager > API Setup).
WHATSAPP_PHONE_NUMBER_ID=""
# Token d'un System User permanent. Jamais un token temporaire de 24 h.
WHATSAPP_ACCESS_TOKEN=""
# Template approuvé contenant un bouton URL dynamique vers /confirmation/{token}.
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="fr"
WHATSAPP_API_VERSION="v25.0"
# Indicatif appliqué aux numéros saisis sans "+" (ex. "229" pour le Bénin).
WHATSAPP_DEFAULT_COUNTRY_CODE=""

# --- FedaPay (collecte XOF) -----------------------------------------------
# sandbox | live
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_API_VERSION="v1"
FEDAPAY_SECRET_KEY=""
# Secret du endpoint webhook (FedaPay Dashboard > Webhooks).
FEDAPAY_WEBHOOK_SECRET=""
FEDAPAY_CURRENCY="XOF"
# Pays par défaut du numéro client transmis à FedaPay.
FEDAPAY_CUSTOMER_COUNTRY="bj"

# --- Android (Capacitor) ---------------------------------------------------
# URL HTTPS chargée par la WebView Android. Doit être identique à
# NEXT_PUBLIC_APP_URL. `cleartext` est désactivé : le HTTP simple est refusé.
CAPACITOR_SERVER_URL="https://your-deployed-genk.example.com"

# --- Signature de la release Android (poste de build uniquement) -----------
# Le keystore n'est jamais versionné (cf. .gitignore). Ces variables ne sont
# lues que par Gradle lors de `npm run android:release`.
ANDROID_KEYSTORE_PATH=""
ANDROID_KEYSTORE_PASSWORD=""
ANDROID_KEY_ALIAS=""
ANDROID_KEY_PASSWORD=""
